{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/session-doctrine.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/governance-trigger.py", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/plan-gate-first-write-reminder.sh", "timeout": 10 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/scope-fence-reminder.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/hooks/governance-enforce.py", "timeout": 15 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/receipt-law-stop-gate.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
